NODE_ENV=development
APP_BASE_URL=http://localhost:8080
API_PORT=3000
TZ=Asia/Shanghai

POSTGRES_DB=valve_course
POSTGRES_USER=valve_course
POSTGRES_PASSWORD=change-this-database-password
DATABASE_URL=postgresql://valve_course:change-this-database-password@postgres:5432/valve_course
REDIS_URL=redis://redis:6379

FILE_STORAGE_ROOT=/data/medical
MAX_UPLOAD_BYTES=104857600
SESSION_COOKIE_SECURE=false
SESSION_TTL_DAYS=30

OMLX_BASE_URL=http://host.docker.internal:5008/v1
OMLX_API_KEY=replace-with-local-secret
OMLX_CHAT_MODEL=Qwen3.8-27B-6bit
OMLX_TIMEOUT_MS=360000

BACKUP_REPOSITORY=/repository
BACKUP_ENCRYPTION_PASSWORD=replace-with-backup-secret
