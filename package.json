{
  "name": "valve-course-private",
  "version": "0.1.0",
  "private": true,
  "description": "Private mitral-valve disease course management system",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24 <26"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @valve/api --filter @valve/web dev",
    "dev:api": "pnpm --filter @valve/api dev",
    "dev:worker": "pnpm --filter @valve/api dev:worker",
    "dev:web": "pnpm --filter @valve/web dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @valve/api db:migrate",
    "db:revert": "pnpm --filter @valve/api db:revert"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1"
  }
}
